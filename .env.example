# 躬行启杭 - 学军中学交流平台
# 环境变量配置模板，复制为 .env 并填入实际值

# DeepSeek API Key
DEEPSEEK_API_KEY=your_api_key_here

# 运行环境：development、test 或 production，必须显式设置
APP_ENV=development

# 管理员请求的可信来源，所有环境均必须显式配置
# development 只允许明确的 localhost/127.0.0.1 来源
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 正式同域部署留空即可；仅在需要跨域调试时填写 TRUSTED_ORIGINS 的子集
CORS_ALLOWED_ORIGINS=

# Uvicorn 可信代理地址
# development/test 必须留空并关闭代理头
# production 必须填写实际 Nginx 的精确 IP；禁止 *、CIDR 和主机名
TRUSTED_PROXY_IPS=

# 管理员密码：production 中至少 12 个字符，且不能使用示例值
ADMIN_PASSWORD=replace-with-a-strong-password

# 管理员会话绝对有效期，允许范围 300 到 28800 秒
ADMIN_SESSION_TTL_SECONDS=7200

# 单进程内存限流器最多保存的桶数量，允许范围 1000 到 100000
RATE_LIMIT_MAX_BUCKETS=20000

# 单个课件文件的应用层大小上限（MB），允许范围 1 到 500
# 50 MiB 默认值对应受限测试 Nginx 的 client_max_body_size 52m；
# 入口额度只预留 multipart 开销，应用仍执行精确文件限制
COURSEWARE_MAX_UPLOAD_MB=50

# 数据库路径（相对路径以项目根目录为基准）
DATABASE_PATH=data/site.db
