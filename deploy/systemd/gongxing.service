[Unit]
Description=Gongxing FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gongxing
Group=gongxing
WorkingDirectory=/opt/gongxing/current/backend
EnvironmentFile=/etc/gongxing/gongxing.env
ExecStart=/opt/gongxing/current/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/gongxing
ReadWritePaths=/var/lib/gongxing
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
