# 只由负责人直接写入服务器 /etc/gongxing/backup.env，权限 0600。
# 未单独批准站外存储、费用、地域和恢复方案前必须保持 0。
OFFSITE_BACKUP_APPROVED=0
# 只接受已批准的远程 restic 仓库；本地路径、file/local 和回环地址会被拒绝。
RESTIC_REPOSITORY=REPLACE_AFTER_SEPARATE_APPROVAL
RESTIC_PASSWORD_FILE=/etc/gongxing/restic-password
# 供应商专属凭据只在批准后由负责人直接添加到服务器，不进入本模板。
RESTIC_PRUNE_ENABLED=0
