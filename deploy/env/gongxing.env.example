# 仅为服务器模板，不得填入真实秘密后提交。
# /etc/gongxing 应为 root:gongxing 0750；本文件安装后应为 root:gongxing 0640。
APP_ENV=production
TRUSTED_ORIGINS=https://test.novocaine.me
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_IPS=127.0.0.1
ADMIN_PASSWORD=REPLACE_ON_SERVER
ADMIN_SESSION_TTL_SECONDS=7200
RATE_LIMIT_MAX_BUCKETS=20000
COURSEWARE_MAX_UPLOAD_MB=50
DATABASE_PATH=/var/lib/gongxing/data/site.db
# 上传目录由应用从项目 data 链接解析到 /var/lib/gongxing/data/uploads。
# 管理员密码只在服务器生成/填写；测试阶段可不配置 DeepSeek Key。
DEEPSEEK_API_KEY=
